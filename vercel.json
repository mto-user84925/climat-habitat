{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/climat.js": {
      "includeFiles": "api/data/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/climat",
      "destination": "/api/climat.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
